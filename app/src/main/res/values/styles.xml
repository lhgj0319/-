<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 方向键：圆形蓝色按钮 -->
    <style name="PadButton">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_direction</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 停止键：圆形红色按钮 -->
    <style name="PadButtonStop">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_stop</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 命令发送按钮 -->
    <style name="CommandButton" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">#DCE8F7</item>
        <item name="android:textColor">#24527A</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>

    <!-- 语音按钮：突出但不抢方向盘主操作 -->
    <style name="VoiceButton" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">#2E9E8F</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
    </style>



</resources>


